# Copy to facepipe.env and edit. Read by facepipe.service and facepipe-web.service; after changes: sudo systemctl restart facepipe
# Source: rtsp://... | file:///path/video.mp4 | csi:0 (CSI camera) | usb:/dev/video0 (USB camera)
FACEPIPE_URI=rtsp://CAMERA_IP:8080/h264_ulaw.sdp
FACEPIPE_MUX_W=1920
FACEPIPE_MUX_H=1080
# process every Nth frame (2 = 15 fps from a 30 fps camera); keep camera_fps / N <= ~19 on a Nano
FACEPIPE_DROP=2
# csi:/usb: capture rate, and USB format: mjpeg (decoded on NVJPG) or raw (YUY2)
FACEPIPE_CAM_FPS=30
FACEPIPE_USB_FORMAT=mjpeg
# face matching: cosine (match when similarity >= FACEPIPE_MATCH) or l2 (match when distance <= FACEPIPE_L2_MATCH)
FACEPIPE_METRIC=cosine
FACEPIPE_MATCH=0.5
FACEPIPE_L2_MATCH=0.95
# data folder; defaults to <app folder>/data
# FACEPIPE_DATA=
# event clips + full-frame evidence (an ext4 volume; recording is off when it is not writable)
FACEPIPE_REC=/mnt/rec
FACEPIPE_WEB_PORT=8000
# exit if no frames arrive for this many seconds, so systemd restarts the service (0 = off)
FACEPIPE_WATCHDOG=60
# detection: every frame while faces are around; after FACEPIPE_IDLE_AFTER s without one (0 = never idle), every
# FACEPIPE_IDLE_STEP-th frame. Video stays at full rate either way.
FACEPIPE_IDLE_AFTER=10
FACEPIPE_IDLE_STEP=6
# the website's Cameras page writes data/cameras.active, which overrides FACEPIPE_URI below
# automatic updates (facepipe-update.timer) follow this GitHub repository's releases
# FACEPIPE_REPO=owner/Jetson-Nano-Face-Recognition-Attendance-System
# log folder: <year>/<Month>/facepipe.log and web.log, one file per day (default: logs/ in the app folder)
# FACEPIPE_LOGS=/path/to/logs
FACEPIPE_RTSP_PORT=8554
FACEPIPE_SITE=Face Attendance
# the site's public https address, used in set-password links for new users (D-040), e.g. the Cloudflare Tunnel hostname
# FACEPIPE_PUBLIC_URL=https://attendance.example.com
# time zone for attendance times, if the system clock is UTC, e.g. TZ=Europe/London
# TZ=
