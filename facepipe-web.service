[Unit]
Description=facepipe attendance web page (port from facepipe.env)
After=network-online.target
RequiresMountsFor=/home

[Service]
User=hamza
WorkingDirectory=/home/hamza/facepipe
EnvironmentFile=/home/hamza/facepipe/facepipe.env
ExecStart=/usr/bin/python3 /home/hamza/facepipe/web.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
