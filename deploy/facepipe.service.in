[Unit]
Description=facepipe face attendance (DeepStream, camera from facepipe.env)
Wants=network-online.target
After=network-online.target
RequiresMountsFor=@APP_DIR@

[Service]
User=@USER@
WorkingDirectory=@APP_DIR@
EnvironmentFile=@APP_DIR@/facepipe.env
Environment=FACEPIPE_DIR=@APP_DIR@
ExecStart=@APP_DIR@/facepipe ${FACEPIPE_URI} ${FACEPIPE_MUX_W} ${FACEPIPE_MUX_H}
# camera off, Wi-Fi drop or crash: reconnect after 10 s, forever
Restart=always
RestartSec=10
# stdout carries embeddings for debugging; keep them out of the journal
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
